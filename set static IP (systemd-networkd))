#check current ip and adapter name
ifconfig

#check if systemd-networkd manages network adapter and locate networkfile
sudo networkctl status adaptername

#edit current networkfile or create one if there is none listed
sudo nano /usr/lib/systemd/network/20-wired.network

#type into file (network configurations will change if its a static ip)
[Match]
Name=adaptername

[Network]
DHCP=yes

#restart network manager
sudo systemctl restart systemd-networkd

#confirm
ifconfig
