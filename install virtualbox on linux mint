#upgrade system
 sudo apt update
 sudo apt upgrade

#install required packages
 sudo apt install wget gnupg2 lsb-release

#edit file (to download repository)
 sudo nano /etc/apt/sources.list.d/virtualbox.list

#add
 deb [arch=amd64 signed-by=/etc/apt/keyrings/oracle-virtualbox.gpg] https://download.virtualbox.org/virtualbox/debian noble contrib

#update system again
 sudo apt update

#install virtualbox (proper version)
 sudo apt install virtualbox-7.2

#launch virtualbox
 virtualbox
